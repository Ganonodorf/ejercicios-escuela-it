@startuml

package Control <<Folder>>{
	class MasterMind
	class ConsoleMasterMind
	class GraphicsMasterMind
}

package Model <<Folder>>{
	class Board
	enum Color
	class Combination
	class Play
	class Result
}

package View <<Folder>>{
	class MasterMindView
	class View
	class ViewWithBoard

	package View.Console <<Folder>>{
		class BoardView
		class ConsoleView
		class LoseView
		class PlayAgainView
		class PlayerView
		class StartView
		class WinView
	}

	package View.Graphics <<Folder>>{
		class GraphicsView
	}
}

MasterMind *-- Board
MasterMind *-- MasterMindView
ConsoleMasterMind -up-|> MasterMind
ConsoleMasterMind --> ConsoleView
GraphicsMasterMind -up-|> MasterMind
GraphicsMasterMind --> GraphicsView
ConsoleView -up-|> MasterMindView
GraphicsView -up-|> MasterMindView
MasterMindView *-- Board
ViewWithBoard -up-|> View
ViewWithBoard *-- Board
BoardView --|> ViewWithBoard
ConsoleView *-- BoardView
ConsoleView *-- PlayerView
ConsoleView *-- WinView
ConsoleView *-- LoseView
ConsoleView *-- StartView
ConsoleView *-- PlayAgainView
ConsoleView --> Combination
LoseView -up-|> View
PlayAgainView -up-|> View
PlayerView -up-|> View
PlayerView *-- Combination
StartView -up-|> View
WinView -up-|> View

Board *-- Combination
Board *-- "8" Play
Combination *-- "4" Color
Play *-- "1" Combination
Play *-- "1" Result

@enduml